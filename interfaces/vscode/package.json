{
  "name": "ai-router-vscode",
  "displayName": "AI Router",
  "description": "Send coding work to the local AI Router control service.",
  "version": "0.6.0",
  "publisher": "ai-router-local",
  "private": true,
  "license": "MIT",
  "author": "Richard R Degregorio (https://github.com/ricdegre)",
  "type": "commonjs",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "aiRouter", "title": "AI Router", "icon": "media/router.svg" }] },
    "views": { "aiRouter": [{ "type": "webview", "id": "aiRouter.control", "name": "Control" }] },
    "commands": [
      { "command": "aiRouter.runTask", "title": "AI Router: Run Task" },
      { "command": "aiRouter.explainRoute", "title": "AI Router: Explain Route" },
      { "command": "aiRouter.openDashboard", "title": "AI Router: Open Dashboard" },
      { "command": "aiRouter.focusMode", "title": "AI Router: Focus Mode" },
      { "command": "aiRouter.refresh", "title": "AI Router: Refresh" }
    ],
    "configuration": {
      "title": "AI Router",
      "properties": {
        "aiRouter.url": { "type": "string", "default": "http://127.0.0.1:43127", "description": "Local AI Router dashboard URL." },
        "aiRouter.openFocusModeAutomatically": { "type": "boolean", "default": false, "description": "Open Focus Mode at startup when the current VS Code folder matches a registered AI Router workspace." },
        "aiRouter.includeSelection": { "type": "boolean", "default": true, "description": "Offer the active text selection as task context." },
        "aiRouter.provider": { "type": "string", "default": "", "description": "Optional AI Router provider ID; blank keeps automatic routing." },
        "aiRouter.profile": { "type": "string", "default": "", "description": "Optional AI Router profile ID selected in the dashboard." },
        "aiRouter.model": { "type": "string", "default": "", "description": "Optional model ID exposed by the selected AI Router profile." },
        "aiRouter.executionChannel": { "type": "string", "default": "", "description": "Optional execution channel selected through AI Router." },
        "aiRouter.reasoningEffort": { "type": "string", "default": "", "enum": ["", "none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra", "ultracode"], "description": "Optional task-level reasoning effort override validated by AI Router." }
      }
    }
  },
  "scripts": { "package": "node -e \"require('node:fs').mkdirSync('../../dist', { recursive: true })\" && vsce package --allow-missing-repository --out ../../dist/ai-router-vscode-0.6.0.vsix" },
  "files": ["extension.js", "router-client.js", "workspace-context.js", "current-task-selection.js", "task-tracking.js", "webview.js", "webview.css", "README.md", "LICENSE", "media/router.svg"],
  "devDependencies": { "@vscode/vsce": "^3.6.2" }
}
